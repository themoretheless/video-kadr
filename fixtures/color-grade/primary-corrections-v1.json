{
  "schemaVersion": 1,
  "workingSpace": "linear-srgb-d65",
  "parameterRange": {"temperature": [-1, 1], "tint": [-1, 1], "highlights": [-1, 1], "shadows": [-1, 1]},
  "defaults": {"temperature": 0, "tint": 0, "highlights": 0, "shadows": 0},
  "order": ["decode-transfer", "temperature-tint", "shadows-highlights", "encode-transfer", "brightness-contrast-saturation", "preset", "lut", "curves"],
  "formula": {
    "channelGains": ["exp2(0.25*temperature-0.10*tint)", "exp2(0.20*tint)", "exp2(-0.25*temperature-0.10*tint)"],
    "luma": "0.2126*r+0.7152*g+0.0722*b after channel gains",
    "shadowMask": "1-smoothstep(0,0.5,luma)",
    "highlightMask": "smoothstep(0.5,1,luma)",
    "tonalGain": "exp2(0.75*(shadows*shadowMask+highlights*highlightMask))",
    "clamp": "finite intermediate; clamp RGB to [0,1] only after tonal gain"
  },
