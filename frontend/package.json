{
  "name": "video-kadr-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:agent": "node scripts/run-agent-mcp-e2e.mjs",
    "test:e2e:real": "node scripts/run-real-composition-e2e.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:lifecycle": "node scripts/check-global-listeners.mjs",
    "bench:canvas": "node bench/canvas/run.mjs",
    "storybook": "storybook dev --no-open",
    "build-storybook": "storybook build",
    "test:stories": "playwright test --config storybook.playwright.config.ts",
    "test:e2e:audio-gain": "node scripts/run-audio-gain-e2e.mjs",
    "test:e2e:native-audio": "node scripts/run-native-audio-preview-e2e.mjs",
    "build:preview-core": "node scripts/build-preview-core.mjs",
    "test:e2e:clipboard": "node scripts/qualify-native-system-clipboard.mjs",
    "test:e2e:clipboard:live": "node scripts/qualify-native-system-clipboard.mjs --live",
    "test:e2e:source-graph": "node scripts/qualify-source-run-graph.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/query-core": "^5.102.8",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/svelte-vite": "^10.5.10",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "axe-core": "4.13.0",
    "eslint": "9.39.4",
    "eslint-plugin-svelte": "3.12.5",
    "globals": "15.15.0",
    "happy-dom": "20.10.6",
    "storybook": "^10.5.10",
    "svelte-check": "4.3.1",
    "terser": "5.47.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
